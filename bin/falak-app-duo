    ai_enabled: true,
    telegram_username: "",
  },
  admin: {
    name: "Layla Haddad",
    email: "admin@demo.dev",
    phone: "+971500000003",
    country_code: "AE",
    city: "Dubai",
    channel: "none",
    channel_handle: "",
    ai_model: "llama-3.1-8b-instant",
    ai_enabled: false,
    telegram_username: "",
  },
  user: {
    name: "Karim Nasser",
    email: "user@demo.dev",
    phone: "+120200000004",
    country_code: "US",
    city: "New York",
    channel: "none",
    channel_handle: "",
    ai_model: "gemma2-9b-it",
    ai_enabled: false,
    telegram_username: "",
  },
};

const DEMO_NOTIFICATIONS = {
  account: { email: true, push: true, sms: false, telegram: false },
  security: { email: true, push: true, sms: true, telegram: false },
  marketing: { email: false, push: false, sms: false, telegram: false },
  updates: { email: true, push: false, sms: false, telegram: false },
};

function buildRolesModule(roleKeys) {
  const lines = [];
  lines.push("// UserRole support. Generated by the scaffolder: only the roles");
  lines.push("// you picked at scaffold time are kept; an empty ROLES means UserRole");
  lines.push('// support is off. `label` is a vue-i18n key (see i18n/locales/*.json).');
  lines.push("export const ROLES = [");
  for (const key of ROLE_ORDER.filter((k) => roleKeys.includes(k))) {
    lines.push(`  { key: "${key}", label: "${ROLE_META[key].label}", badge: "${ROLE_META[key].badge}" },`);
  }
  lines.push("];");
  return lines.join("\n") + "\n";
}

function demoSettingsFor(roleKey) {
  const seed = roleKey ? DEMO_ROLE_SEED[roleKey] : null;
  return {
    notification_preferences: DEMO_NOTIFICATIONS,
    two_factor_enabled: false,
    ai_agent: {
      enabled: seed ? seed.ai_enabled : false,
      model: seed ? seed.ai_model : "llama-3.3-70b-versatile",
      temperature: 0.7,
      reasoning: false,
      system_prompt: "",
    },
    telegram: { bot_token: "", chat_id: "", username: seed ? seed.telegram_username : "" },
  };
}

// roleKeys == [] => a single normal demo user (no role on the account).
function buildDemoAccountsModule(roleKeys) {
  const chosen = ROLE_ORDER.filter((k) => roleKeys.includes(k));
  const accounts = chosen.length
    ? chosen.map((key) => {
        const s = DEMO_ROLE_SEED[key];
        return {
          role: key,
          email: s.email,
          password: "password",
          profile: {
            name: s.name,
            email: s.email,
            phone: s.phone,
            country_code: s.country_code,
            city: s.city,
            channel: s.channel,
            channel_handle: s.channel_handle,
            photo: null,
          },
          settings: demoSettingsFor(key),
        };
      })
    : [
        {
          role: null,
          email: "demo@demo.dev",
          password: "password",
          profile: {
            name: "Demo User",
            email: "demo@demo.dev",
            phone: "+201000000009",
            country_code: "EG",
            city: "Cairo",
            channel: "none",
            channel_handle: "",
            photo: null,
          },
          settings: demoSettingsFor(null),
        },
      ];
  const lines = [];
  lines.push("// Static demo accounts for testing. Generated by the scaffolder: one");
  lines.push("// account per role you picked, or a single normal demo user when");
  lines.push("// UserRole support is off. Each carries its full profile and default");
  lines.push("// settings so a backend seed (or a first-login init) has everything.");
  lines.push("export const DEMO_ACCOUNTS = [");
  for (const account of accounts) {
    lines.push("  " + JSON.stringify(account) + ",");
  }
  lines.push("];");
  return lines.join("\n") + "\n";
}

function parseList(value) {
  return String(value || "")
    .split(",")
    .map((x) => x.trim())
    .filter(Boolean);
}

function keepCanonicalOrder(value, allowed) {
  const picked = parseList(value);
  return allowed.filter((item) => picked.includes(item));
}

function buildI18nModule(locales, defaultLocale) {
  const ordered = ["ar", "en", "es", "de", "fr", "ru", "it"].filter((c) => locales.includes(c));
  const lines = [];
  lines.push('import { createI18n } from "vue-i18n";');
  for (const code of ordered) {
    lines.push(`import ${code} from "./locales/${code}.json";`);
  }
  lines.push("");
  lines.push("export const SUPPORTED_LOCALES = [");
  for (const code of ordered) {
    lines.push(`  { code: "${code}", label: "${LOCALE_LABELS[code]}" },`);
  }
  lines.push("];");
  lines.push("");
  lines.push('const STORAGE_KEY = "falak_locale";');
  lines.push("const stored = localStorage.getItem(STORAGE_KEY);");
  lines.push(
    `const savedLocale = SUPPORTED_LOCALES.some((l) => l.code === stored) ? stored : "${defaultLocale}";`
  );
  lines.push("");
  lines.push("const i18n = createI18n({");
  lines.push("  legacy: false,");
  lines.push("  locale: savedLocale,");
  lines.push('  fallbackLocale: "en",');
  lines.push(`  messages: { ${ordered.join(", ")} },`);
  lines.push("});");
  lines.push("");
  lines.push("export function setLocale(locale) {");
  lines.push("  i18n.global.locale.value = locale;");
  lines.push("  localStorage.setItem(STORAGE_KEY, locale);");
  lines.push("  document.documentElement.lang = locale;");
  lines.push('  document.documentElement.dir = locale === "ar" ? "rtl" : "ltr";');
  lines.push("}");
  lines.push("");
  lines.push("// Apply on load");
  lines.push("setLocale(savedLocale);");
  lines.push("");
  lines.push("export default i18n;");
  lines.push("");
  return lines.join("\n");
}

const program = new Command();
program
  .name("falak-app")
  .description("Scaffold a Vue 3 app with Ably, Brevo, AES-256 and a Laravel API client baked in.")
  .argument("[project-name]", "Directory to create the project in")
  .option("-y, --yes", "Skip prompts and use defaults (services + languages only; no roles/demo)")
  .option("--no-rtl", "Exclude Arabic/RTL (English or your chosen LTR languages only)")
  .option("--roles <list>", "Enable UserRole support with the given comma-separated roles (master,super_admin,admin,user)")
  .option("--demo-accounts", "Include static demo accounts (per selected role, or a normal demo user without roles)")
  .option("--demo-data <list>", "Include static demo data for the given comma-separated entities (e.g. products,orders)")
  .parse(process.argv);

const [argProjectName] = program.args;
const opts = program.opts();

function randomHex(bytes) {
  return crypto.randomBytes(bytes).toString("hex");
}

function runInProject(dir, command, args) {
  return new Promise((resolve, reject) => {
    const child = spawn(command, args, {
      cwd: dir,
      stdio: "inherit",
      shell: process.platform === "win32",
    });
    child.on("error", reject);
    child.on("close", (code) => {
      if (code === 0) resolve();
      else reject(new Error(`\`${command} ${args.join(" ")}\` exited with code ${code}`));
    });
  });
}

async function printBanner() {
  const art = (await figlet("Falak Duo", { font: "ANSI Shadow" }).catch(() => null)) || "Falak Duo";
  console.log("\n" + gradient("#a78bfa", "#22d3ee", "#2dd4bf")(art));
  console.log(
    chalk.gray("  Vue 3 boilerplate \u2014 Ably \u00b7 Brevo \u00b7 AES-256 \u00b7 Multilingual / RTL")
  );
  console.log("\n");
}

async function main() {
  await printBanner();

  const defaults = {
    projectName: argProjectName || "falak-app-duo",
    services: ["ably", "brevo"],
    languages: ["ar"],
    apiBaseUrl: "http://localhost:8000/api",
  };

  const hasFeatureFlags =
    opts.roles !== undefined || opts.demoAccounts !== undefined || opts.demoData !== undefined;

  // Feature outcomes. Roles/accounts/data only come via explicit flags or
  // interactive prompts — `--yes` keeps the minimal scaffold.
  let roles = opts.yes ? [] : null;
  let demoAccounts = opts.yes ? false : null;
  let demoEntities = opts.yes ? [] : null;

  let answers;
  if (opts.yes || hasFeatureFlags) {
    answers = { ...defaults };
  } else {
    answers = await prompts(
      [
        {
          type: argProjectName ? null : "text",
          name: "projectName",
          message: "Project name / folder:",
          initial: "falak-app-duo",
        },
        {
          type: "multiselect",
          name: "services",
          message: "Which services do you want wired up?",
          choices: [
            { title: "Ably (realtime, via Laravel Echo)", value: "ably", selected: true },
            { title: "Brevo (email/SMS, via backend)", value: "brevo", selected: true },
          ],
          hint: "Space to toggle, Enter to confirm",
        },
        {
          type: "multiselect",
          name: "languages",
          message: "Which languages should the app ship with? (English is always included)",
          choices: LANGUAGE_CHOICES.map((c) =>
            c.value === "ar" && !opts.rtl ? { ...c, selected: false } : c
          ),
          hint: "Space to toggle, Enter to confirm",
        },
        {
          type: "text",
          name: "apiBaseUrl",
          message: "Laravel API base URL:",
          initial: "http://localhost:8000/api",
        },
      ],
      { onCancel: () => process.exit(1) }
    );
  }

  // ---- UserRole support ----
  if (!opts.yes && hasFeatureFlags) {
    roles = opts.roles !== undefined ? keepCanonicalOrder(opts.roles, ROLE_ORDER) : [];
    demoAccounts = Boolean(opts.demoAccounts);
    demoEntities = opts.demoData !== undefined ? keepCanonicalOrder(opts.demoData, DEMO_ENTITIES) : [];
  } else if (!opts.yes) {
    const wantRoles = (
      await prompts(
        {
          type: "toggle",
          name: "v",
          message: "Register accounts with a role (UserRole support)?",
          initial: true,
          active: "yes",
          inactive: "no",
        },
        { onCancel: () => process.exit(1) }
      )
    ).v;
    if (wantRoles) {
      const { r } = await prompts(
        {
          type: "multiselect",
          name: "r",
          message: "Which roles should auth support?",
          choices: ROLE_ORDER.map((k) => ({ title: k, value: k, selected: true })),
          hint: "Space to toggle, Enter to confirm",
        },
        { onCancel: () => process.exit(1) }
      );
      roles = r || [];
    }

    const wantAccounts = (
      await prompts(
        {
          type: "toggle",
          name: "v",
          message: roles.length
            ? "Create demo accounts (one per selected role)?"
            : "Create a normal demo account?",
          initial: true,
          active: "yes",
          inactive: "no",
        },
        { onCancel: () => process.exit(1) }
      )
    ).v;
    demoAccounts = Boolean(wantAccounts);

    const wantData = (
      await prompts(
        {
          type: "toggle",
          name: "v",
          message: "Create static demo data to test with?",
          initial: true,
          active: "yes",
          inactive: "no",
        },
        { onCancel: () => process.exit(1) }
      )
    ).v;
    if (wantData) {
      const { e } = await prompts(
        {
          type: "multiselect",
          name: "e",
          message: "Which demo-data entities should the app ship with?",
          choices: DEMO_ENTITIES.map((k) => ({ title: k, value: k, selected: true })),
          hint: "Space to toggle, Enter to confirm",
        },
        { onCancel: () => process.exit(1) }
      );
      demoEntities = e || [];
    }
  }

  // The set of locales the app ships: English is always bundled, plus the
  // languages the user picked. `--no-rtl` forces Arabic out (LTR only).
  let locales = ["en", ...(answers.languages || [])];
  locales = [...new Set(locales)];
  if (!opts.rtl) {
    locales = locales.filter((l) => l !== "ar");
  }
  const hasRtl = locales.includes("ar");
  const defaultLocale = hasRtl ? "ar" : "en";

  const projectName = argProjectName || answers.projectName;
  const services = answers.services || [];
  const targetDir = path.resolve(process.cwd(), projectName);

  if (await fs.pathExists(targetDir)) {
    const files = await fs.readdir(targetDir);
    if (files.length > 0) {
      console.log(chalk.red(`\n  Directory "${projectName}" already exists and is not empty.\n`));
      process.exit(1);
    }
  }

  console.log(chalk.gray(`\n  Scaffolding into ./${projectName} ...\n`));
  await fs.copy(TEMPLATE_DIR, targetDir);

  // Rename the app's package.json placeholder and set the real project name
  const pkgPath = path.join(targetDir, "package.json");
  const pkg = await fs.readJson(pkgPath);
  pkg.name = projectName
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, "-")
    .replace(/-+/g, "-");
  await fs.writeJson(pkgPath, pkg, { spaces: 2 });

  // Remove service files the user didn't select
  const serviceFiles = {
    ably: "src/services/ably.js",
    brevo: "src/services/brevo.js",
  };
  for (const [key, relPath] of Object.entries(serviceFiles)) {
    if (!services.includes(key)) {
      await fs.remove(path.join(targetDir, relPath));
    }
  }

  // Wire i18n to exactly the selected languages: rewrite index.html lang/dir,
  // regenerate src/i18n/index.js, and drop unselected locale bundles. The
  // template ships Arabic+RTL by default; --no-rtl (or deselecting Arabic)
  // yields an LTR-only app.
  const htmlPath = path.join(targetDir, "index.html");
  const html = await fs.readFile(htmlPath, "utf-8");
  const htmlTag = hasRtl ? '<html lang="ar" dir="rtl">' : '<html lang="en" dir="ltr">';
  await fs.writeFile(htmlPath, html.replace('<html lang="ar" dir="rtl">', htmlTag));

  const i18nPath = path.join(targetDir, "src", "i18n", "index.js");
  await fs.writeFile(i18nPath, buildI18nModule(locales, defaultLocale));

  for (const file of EXTRA_LOCALE_FILES) {
    if (!locales.includes(file.replace(".json", ""))) {
      await fs.remove(path.join(targetDir, "src", "i18n", "locales", file));
    }
  }

  // English-only app: strip the language switcher (and its setup) from App.vue.
  if (locales.length === 1) {
    const appPath = path.join(targetDir, "src", "App.vue");
    let app = await fs.readFile(appPath, "utf-8");
    app = app.replace('import { setLocale, SUPPORTED_LOCALES } from "@/i18n";\n', "");
    app = app.replace("const { t, locale } = useI18n();", "const { t } = useI18n();");
    app = app.replace("const locales = SUPPORTED_LOCALES;\n", "");
    app = app.replace(/\n\s*<select\s*v-if="locales\.length > 1"[\s\S]*?<\/select>/, "");
    await fs.writeFile(appPath, app);
  }

  // UserRole support: rewrite src/data/roles.js to the picked role set. The
  // file always stays (Register/Profile import it), just emptied when off.
  await fs.writeFile(path.join(targetDir, "src", "data", "roles.js"), buildRolesModule(roles || []));

  // Demo accounts: static module with one account per role, or a single
  // normal demo user when roles are off. Removed entirely when not wanted.
  const demoAccountsPath = path.join(targetDir, "src", "data", "demoAccounts.js");
  if (demoAccounts) {
    await fs.writeFile(demoAccountsPath, buildDemoAccountsModule(roles || []));
  } else {
    await fs.remove(demoAccountsPath);
  }

  // Static demo data: keep only the selected entity modules. The whole demo
  // dir is dropped when demo data wasn't picked (nothing imports it).
  const demoDir = path.join(targetDir, "src", "data", "demo");
  for (const entity of DEMO_ENTITIES) {
    if (!demoEntities || !demoEntities.includes(entity)) {
      await fs.remove(path.join(demoDir, `${entity}.js`));
    }
  }
  if (!demoEntities || (await fs.readdir(demoDir).catch(() => [])).length === 0) {
    await fs.remove(demoDir);
  }

  const demoAccountsSummary = demoAccounts
    ? roles && roles.length
      ? `${roles.length} (${roles.join(", ")})`
      : "1 (normal demo user)"
    : "none";

  console.log(
    chalk.gray(`  Languages wired: ${locales.map((l) => LOCALE_LABELS[l]).join(", ")}${hasRtl ? " (RTL default)" : ""}`)
  );
  console.log(
    chalk.gray(
      `  Roles: ${roles && roles.length ? roles.join(", ") : "none"} | Demo accounts: ${demoAccountsSummary} | Demo data: ${demoEntities && demoEntities.length ? demoEntities.join(", ") : "none"}`
    )
  );

  // Generate a real .env from .env.example with a fresh encryption key
  const envExamplePath = path.join(targetDir, ".env.example");
  let envContent = await fs.readFile(envExamplePath, "utf-8");
  envContent = envContent
    .replace("__API_BASE_URL__", answers.apiBaseUrl || "http://localhost:8000/api")
    .replace("__AES_KEY__", randomHex(32)) // 256-bit key, hex-encoded
    .replace("__AES_IV__", randomHex(16)); // 128-bit IV, hex-encoded
  await fs.writeFile(path.join(targetDir, ".env"), envContent);

  console.log(chalk.green(`\n  Scaffolded ./${projectName} successfully.\n`));
  console.log(
    chalk.gray(
      "  Fill in VITE_API_KEY, VITE_ABLY_PUBLIC_KEY, Brevo backend routes, and review .env before shipping.\n"
    )
  );

  const runChoice = opts.yes || hasFeatureFlags
    ? "install"
    : (
        await prompts(
          {
            type: "select",
            name: "run",
            message: "Ready to start coding?",
            choices: [
              { title: "Install dependencies, then start the dev server", value: "dev" },
              { title: "Install dependencies only", value: "install" },
              { title: "Skip \u2014 I'll run it myself", value: "skip" },
            ],
            initial: 0,
          },
          { onCancel: () => process.exit(1) }
        )
      ).run;

  if (runChoice === "skip") {
    console.log(chalk.white(`    cd ${projectName}`));
    console.log(chalk.white("    npm install"));
    console.log(chalk.white("    npm run dev\n"));
    return;
  }

  console.log(chalk.cyan("\n  Installing dependencies...\n"));
  await runInProject(targetDir, "npm", ["install"]);

  if (runChoice === "install") {
    console.log(chalk.white("\n  Next: cd into the project and run `npm run dev`\n"));
    return;
  }

  console.log(chalk.cyan("\n  Starting the dev server (Ctrl+C to stop)...\n"));
  await runInProject(targetDir, "npm", ["run", "dev"]).catch(() => {});
}

function isMain() {
  const argv1 = process.argv[1];
  if (!argv1) return false;
  try {
    // Resolve symlinks on both sides: npx/npm exec spawn the bin through the
    // `node_modules/.bin/<name>` symlink, so a raw `argv[1] === import.meta.url`
    // comparison would silently skip main() when run via npx.
    return realpathSync(argv1) === fileURLToPath(import.meta.url);
  } catch {
    return false;
  }
}

if (isMain()) {
  main().catch((err) => {
    console.error(chalk.red(err));
    process.exit(1);
  });
}

export { buildI18nModule };